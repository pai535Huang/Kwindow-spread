<ui version="4.0">
 <class>KWin::KwindowSpreadConfigForm</class>
 <widget class="QWidget" name="KWin::KwindowSpreadConfigForm">
  <property name="windowTitle">
   <string>Kwindow-spread</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QCheckBox" name="kcfg_KeepCurrentFocus">
     <property name="text">
      <string>Keep focus on the current window when a new window opens</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_CreateVirtualDesktops">
     <property name="text">
      <string>Create a virtual desktop when the target desktop does not exist</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
    <item>
     <widget class="QCheckBox" name="kcfg_RemoveEmptyVirtualDesktops">
      <property name="text">
       <string>Remove empty virtual desktops after windows close</string>
      </property>
      <property name="checked">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="sameDesktopGroupsBox">
     <property name="title">
       <string>Windows that stay together on one desktop</string>
     </property>
     <layout class="QVBoxLayout" name="sameDesktopGroupsLayout">
      <item>
       <widget class="QLabel" name="sameDesktopGroupsLabel">
        <property name="text">
         <string>One group per line. Separate aliases in a group with English commas. Wildcards: * and ?.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPlainTextEdit" name="kcfg_SameDesktopWindowGroups">
        <property name="kcfg_property" stdset="0">
         <cstring>plainText</cstring>
        </property>
        <property name="placeholderText">
         <string>wechat, WeChat
qq
virt-manager
*preview*</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="sourceDesktopApplicationsBox">
     <property name="title">
      <string>Applications that stay on their original desktop</string>
     </property>
     <layout class="QVBoxLayout" name="sourceDesktopApplicationsLayout">
      <item>
       <widget class="QLabel" name="sourceDesktopApplicationsLabel">
        <property name="text">
         <string>One application per line. Matches app ID and WM_CLASS. Wildcards: * and ?.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPlainTextEdit" name="kcfg_SourceDesktopApplications">
        <property name="kcfg_property" stdset="0">
         <cstring>plainText</cstring>
        </property>
        <property name="placeholderText">
         <string>spectacle
org.kde.spectacle</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
